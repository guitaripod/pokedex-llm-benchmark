{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pokedex-deepseek-v4-flash-r2",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "DEX_KV",
